# Plantilla de producción para docker-compose (copiar a backend/.env en el servidor, permisos 600).
# Sin valores reales: genera cada secreto con `openssl rand -base64 48`.

PORT=4000
NODE_ENV=production
DEMO_MODE=false

# La URL de la base la fija el compose (servicio `postgres`); no hace falta definirla aquí.

JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Dominio público (el que sirve Cloudflare).
APP_URL=https://gruascares.cl
CORS_ORIGIN=https://gruascares.cl

# Cloudflare Tunnel → cloudflared → frontend → backend: 2 saltos de confianza (ver docs/DEPLOYMENT.md).
TRUST_PROXY=2

# Correo (DataTecno u otro proveedor SMTP). EMAIL_FROM debe ser una casilla de la misma cuenta.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Grúas Cares <no-responder@gruascares.cl>"

AUDIT_RETENTION_MONTHS=12

# Solo con `--profile redis`: redis://:<REDIS_PASSWORD>@redis:6379
REDIS_URL=
