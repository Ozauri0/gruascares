# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Seguridad & CORS (Permitir frontend de desarrollo y dominio de producción)
CORS_ORIGIN=http://localhost:3000,https://gruascares.cl

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gruas_cares

# Autenticación JWT
JWT_SECRET=super_secret_jwt_key_gruas_cares_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Notificaciones por Correo (SMTP / Resend / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contacto@gruascares.cl
SMTP_PASS=tu_app_password
EMAIL_FROM="Grúas Cares <contacto@gruascares.cl>"
