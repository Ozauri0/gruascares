# Configuración del Servidor
PORT=4000
# Si NODE_ENV se omite se asume "production" (modo estricto).
NODE_ENV=development

# Seguridad & CORS (lista exacta de orígenes; en desarrollo también se acepta localhost)
CORS_ORIGIN=http://localhost:3000,https://gruascares.cl

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gruas_cares

# Autenticación JWT (obligatorio en producción, mínimo 32 caracteres).
# Generar uno: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Notificaciones por Correo (SMTP / Resend / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contacto@gruascares.cl
SMTP_PASS=tu_app_password
EMAIL_FROM="Grúas Cares <contacto@gruascares.cl>"

# Cantidad de proxies de confianza delante del backend (para req.ip y rate limiting).
# false (por defecto), true o un número de saltos, p. ej. 1 detrás de nginx.
TRUST_PROXY=false

# Costo de bcrypt para contraseñas (4-14; por defecto 12).
BCRYPT_ROUNDS=12

# Login demo sin credenciales (POST /api/auth/demo-login) para la maqueta. NUNCA en producción:
# con NODE_ENV=production el servidor se niega a arrancar si está en true. Requiere `bun run db:seed`.
DEMO_MODE=false

# URL pública del frontend, usada en los enlaces de los correos (recuperación de contraseña).
APP_URL=http://localhost:3000
